{
  "expo": {
    "name": "Playworld",
    "slug": "packworld",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "no.playworld.dashboard",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "playworld",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ee794f3-daaa-4286-bfd0-f69ed41194bf"
      }
    },
    "owner": "playworld"
  }
}
