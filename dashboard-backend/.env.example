PORT=3000

# Shared key the app must send (x-api-key header). Leave empty locally; always set it on Render.
API_KEY=

# true = run the browser hidden; set to false to watch it while debugging
HEADLESS=true

# How long dashboard data is cached, in seconds
CACHE_TTL_SECONDS=60

# Location 1 (Service A): Wallmob back office
SERVICE_A_URL=https://wbo-etail.wallmob.com
SERVICE_A_USERNAME=
SERVICE_A_PASSWORD=

# Location 2 (Service B): NordPay admin
SERVICE_B_URL=https://admin.nordpay.no
SERVICE_B_USERNAME=
SERVICE_B_PASSWORD=

# FunButler bookings
FUNBUTLER_URL=https://booking.funbutler.com
FUNBUTLER_USERNAME=
FUNBUTLER_PASSWORD=

# Planday staff schedule (Service D)
PLANDAY_URL=https://playworld.planday.com
PLANDAY_USERNAME=
PLANDAY_PASSWORD=

# App and website login (password only). Changing it logs out every phone and browser.
APP_PASSWORD=

# Triaden: the same variables with a TRIADEN_ prefix (TRIADEN_SERVICE_A_USERNAME, TRIADEN_SERVICE_A_PASSWORD, …,
# TRIADEN_PLANDAY_PASSWORD). URLs fall back to the ones above. Until they're set, Triaden shows as "Kommer snart".

# Push notification tokens (JSON file). On Render, use a persistent disk path, e.g. /var/data/push-tokens.json.
PUSH_TOKENS_FILE=data/push-tokens.json
